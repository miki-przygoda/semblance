# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
target/
debug/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these (debugging information)
*.pdb

# NOTE: Cargo.lock is intentionally COMMITTED. This workspace ships a binary
# (`semblance`), and for binaries the lockfile is what makes builds reproducible.
# Do not add it here.

# ---------------------------------------------------------------------------
# Connectome data
# ---------------------------------------------------------------------------
# Real FlyWire / MaleCNS exports are large and are not ours to redistribute.
# Keep them out of git and document how to re-fetch them in RESOURCES.md.
# Small test fixtures belong in crates/*/tests/fixtures/ and stay tracked.
/data/
*.parquet
*.feather
*.npy
*.npz
*.h5
*.hdf5
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Experiment output
# ---------------------------------------------------------------------------
# Fidelity sweeps, evolution runs, and their figures are reproducible from code.
/out/
/runs/
/results/
/figures/
*.log

# Learned decoders (the autoencoder route in DESIGN.md trains offline)
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt

# ---------------------------------------------------------------------------
# Python sidecar (offline training / data wrangling per RESOURCES.md)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# CAVEclient / FlyWire access tokens must never be committed.
.env
*.local
secrets.toml

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/
